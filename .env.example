# Python Mastery - Environment Configuration Reference
# Duplicate this file to .env and adjust values for your deployment environment.

# ==============================================================================
# Database Configuration
# ==============================================================================
# Local SQLite fallback: sqlite:///./mastery.db
# Production PostgreSQL (Supabase / Render / Docker):
DATABASE_URL=postgresql://postgres:mastery_secure_password_2026@localhost:5432/mastery_db

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
JWT_SECRET_KEY=generate_a_64_character_hex_random_secret_string_here_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==============================================================================
# Server & CORS Configuration
# ==============================================================================
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://python-mastery.vercel.app"]

# ==============================================================================
# AI Mentor Service
# ==============================================================================
# Optional OpenAI API Key for live AI Socratic feedback.
# If omitted, the server uses deterministic algorithmic Socratic hint generation.
OPENAI_API_KEY=

# ==============================================================================
# Frontend Environment Configuration (frontend/.env.local)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api
