    "slug": "challenge-factorial",
    "title": "Factorial Calculator",
    "difficulty": "easy",
    "instructions": "Write `factorial(n: int) -> int` returning the factorial of n (where 0! = 1).",
    "starter_code": "def factorial(n: int) -> int:\n    pass\n",
    "solution_code": "def factorial(n: int) -> int:\n    res = 1\n    for i in range(2, n + 1):\n        res *= i\n    return res\n",
    "entry_function_name": "factorial",
    "test_cases": [
      {
        "input": [
          5
        ],
        "expected": 120,
        "description": "5! = 120",
        "is_hidden": false
      },
      {
