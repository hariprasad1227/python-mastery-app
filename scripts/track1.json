    "slug": "challenge-leap-year",
    "title": "Leap Year Validator",
    "difficulty": "easy",
    "instructions": "Write `is_leap_year(year: int) -> bool` returning True if year is a leap year (divisible by 4, except century years unless divisible by 400).",
    "starter_code": "def is_leap_year(year: int) -> bool:\n    pass\n",
    "solution_code": "def is_leap_year(year: int) -> bool:\n    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n",
    "entry_function_name": "is_leap_year",
    "test_cases": [
      {
        "input": [
          2024
        ],
        "expected": true,
        "description": "2024 is leap",
        "is_hidden": false
      },
      {
        "input": [
          1900
        ],
        "expected": false,
        "description": "1900 is century non-leap",
        "is_hidden": false
      },
      {
        "input": [
          2000
        ],
        "expected": true,
        "description": "2000 is 400-year leap",
        "is_hidden": true
      }
    ],
    "hints": [
      "Check year % 400 == 0 first.",
      "Check year % 4 == 0 and year % 100 != 0."
    ],
    "xp_reward": 70,
