  {
    "id": "chal-4",
    "order_index": 4,
    "level_number": 1,
    "slug": "challenge-palindrome",
    "title": "Palindrome Checker",
    "difficulty": "easy",
    "instructions": "Write `is_palindrome(text: str) -> bool` returning True if text is a palindrome (ignoring case & non-alphanumerics).",
    "starter_code": "def is_palindrome(text: str) -> bool:\n    pass\n",
    "solution_code": "def is_palindrome(text: str) -> bool:\n    c = ''.join(ch.lower() for ch in text if ch.isalnum())\n    return c == c[::-1]\n",
    "entry_function_name": "is_palindrome",
    "test_cases": [
      {
        "input": [
          "racecar"
        ],
        "expected": true,
        "description": "racecar",
        "is_hidden": false
      },
      {
        "input": [
          "hello"
        ],
        "expected": false,
        "description": "hello",
        "is_hidden": false
      },
      {
        "input": [
          "A man, a plan, a canal: Panama"
        ],
        "expected": true,
        "description": "Panama sentence",
        "is_hidden": true
      }
    ],
    "hints": [
      "Clean string with isalnum().",
      "Compare with slice [::-1]."
    ],
    "xp_reward": 80,
    "time_limit_seconds": 308,
    "sandbox_timeout_seconds": 3.0
  },
  {
    "id": "chal-5",
    "order_index": 5,
    "level_number": 1,
    "slug": "challenge-word-frequency",
    "title": "Word Frequency Counter",
    "difficulty": "easy",
    "instructions": "Write `count_frequencies(words: list[str]) -> dict[str, int]` counting frequency of each word.",
    "starter_code": "def count_frequencies(words: list[str]) -> dict[str, int]:\n    pass\n",
    "solution_code": "def count_frequencies(words: list[str]) -> dict[str, int]:\n    f = {}\n    for w in words:\n        f[w] = f.get(w, 0) + 1\n    return f\n",
    "entry_function_name": "count_frequencies",
    "test_cases": [
      {
        "input": [
          [
            "apple",
            "banana",
            "apple"
          ]
        ],
        "expected": {
          "apple": 2,
          "banana": 1
        },
        "description": "Word frequencies",
        "is_hidden": false
      },
      {
        "input": [
          [
            "cat",
            "dog",
            "cat",
            "bird"
          ]
        ],
        "expected": {
          "cat": 2,
          "dog": 1,
          "bird": 1
        },
        "description": "Animals list",
        "is_hidden": false
      },
      {
        "input": [
          []
        ],
        "expected": {},
        "description": "Empty list",
        "is_hidden": true
      }
    ],
    "hints": [
      "Initialize dict.",
      "Use dict.get(w, 0) + 1."
    ],
    "xp_reward": 85,
    "time_limit_seconds": 310,
    "sandbox_timeout_seconds": 3.0
  },
