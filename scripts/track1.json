          0
        ],
        "expected": 1,
        "description": "0! = 1",
        "is_hidden": false
      },
      {
        "input": [
          6
        ],
        "expected": 720,
        "description": "6! = 720",
        "is_hidden": true
      }
    ],
    "hints": [
      "Start with res = 1.",
      "Loop from 2 to n."
    ],
    "xp_reward": 65,
    "time_limit_seconds": 314,
