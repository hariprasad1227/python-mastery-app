    "difficulty": "easy",
    "instructions": "Write `sum_multiples(limit: int, factor: int) -> int` summing integers <= limit divisible by factor.",
    "starter_code": "def sum_multiples(limit: int, factor: int) -> int:\n    pass\n",
    "solution_code": "def sum_multiples(limit: int, factor: int) -> int:\n    return sum(i for i in range(factor, limit + 1, factor))\n",
    "entry_function_name": "sum_multiples",
    "test_cases": [
      {
        "input": [
          10,
          3
        ],
        "expected": 18,
