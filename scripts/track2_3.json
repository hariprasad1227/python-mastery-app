    "difficulty": "easy",
    "instructions": "Write `merge_scores(dict1: dict[str, int], dict2: dict[str, int]) -> dict[str, int]` summing values for overlapping keys.",
    "starter_code": "def merge_scores(dict1: dict, dict2: dict) -> dict:\n    pass\n",
    "solution_code": "def merge_scores(dict1: dict, dict2: dict) -> dict:\n    res = dict(dict1)\n    for k, v in dict2.items():\n        res[k] = res.get(k, 0) + v\n    return res\n",
    "entry_function_name": "merge_scores",
    "test_cases": [
