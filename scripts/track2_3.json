          2,
          3,
          5,
          7
        ],
        "description": "1 to 10",
        "is_hidden": false
      },
      {
        "input": [
          [
            0,
            1,
            4,
            6
          ]
        ],
        "expected": [],
        "description": "No primes",
        "is_hidden": false
      },
      {
