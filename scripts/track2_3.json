    "slug": "challenge-second-largest",
    "title": "Find Second Largest Number",
    "difficulty": "easy",
    "instructions": "Write `second_largest(numbers: list[int]) -> int` returning the second distinct largest number in a list of integers.",
    "starter_code": "def second_largest(numbers: list[int]) -> int:\n    pass\n",
    "solution_code": "def second_largest(numbers: list[int]) -> int:\n    unique = sorted(list(set(numbers)))\n    if len(unique) < 2:\n        return unique[0]\n    return unique[-2]\n",
