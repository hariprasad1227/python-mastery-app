[
  {
    "id": "chal-11",
    "order_index": 11,
    "level_number": 2,
    "slug": "challenge-remove-duplicates",
    "title": "Remove Duplicates Preserving Order",
    "difficulty": "easy",
    "instructions": "Write `remove_duplicates(items: list) -> list` removing duplicates while preserving the order of first appearance.",
    "starter_code": "def remove_duplicates(items: list) -> list:\n    pass\n",
    "solution_code": "def remove_duplicates(items: list) -> list:\n    seen = set()\n    out = []\n    for x in items:\n        if x not in seen:\n            seen.add(x)\n            out.append(x)\n    return out\n",
    "entry_function_name": "remove_duplicates",
    "test_cases": [
      {
        "input": [
          [
            1,
            2,
            2,
            3,
            4,
            3,
            5
          ]
        ],
        "expected": [
          1,
          2,
          3,
          4,
          5
        ],
        "description": "Numbers with dupes",
        "is_hidden": false
      },
      {
        "input": [
          [
            "a",
            "b",
            "a",
            "c"
          ]
        ],
        "expected": [
          "a",
          "b",
          "c"
        ],
        "description": "Strings with dupes",
        "is_hidden": false
      },
      {
        "input": [
          [
            1,
            1,
            1
          ]
        ],
        "expected": [
          1
        ],
        "description": "All identical",
        "is_hidden": true
      }
    ],
    "hints": [
      "Use a set to track seen elements.",
      "Append unseen to a new list."
    ],
    "xp_reward": 70,
    "time_limit_seconds": 322,
    "sandbox_timeout_seconds": 3.0
  },
  {
