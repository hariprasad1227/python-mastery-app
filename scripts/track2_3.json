    "solution_code": "def is_anagram(s1: str, s2: str) -> bool:\n    c1 = sorted([c.lower() for c in s1 if c.isalnum()])\n    c2 = sorted([c.lower() for c in s2 if c.isalnum()])\n    return c1 == c2\n",
