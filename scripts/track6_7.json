    "difficulty": "medium",
    "instructions": "Write `max_sub_array(nums: list[int]) -> int` returning the largest sum of any contiguous subarray.",
    "starter_code": "def max_sub_array(nums: list[int]) -> int:\n    pass\n",
    "solution_code": "def max_sub_array(nums: list[int]) -> int:\n    max_so_far = nums[0]\n    cur_max = nums[0]\n    for x in nums[1:]:\n        cur_max = max(x, cur_max + x)\n        max_so_far = max(max_so_far, cur_max)\n    return max_so_far\n",
