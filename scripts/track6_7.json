    "difficulty": "medium",
    "instructions": "Write `merge_sorted(a: list[int], b: list[int]) -> list[int]` merging two sorted lists into one sorted list in O(n+m).",
    "starter_code": "def merge_sorted(a: list[int], b: list[int]) -> list[int]:\n    pass\n",
    "solution_code": "def merge_sorted(a: list[int], b: list[int]) -> list[int]:\n    i, j = 0, 0\n    res = []\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            res.append(a[i])\n            i += 1\n        else:\n            res.append(b[j])\n            j += 1\n    res.extend(a[i:])\n    res.extend(b[j:])\n    return res\n",
    "entry_function_name": "merge_sorted",
    "test_cases": [
      {
        "input": [
          [
            1,
            3,
            5
          ],
          [
            2,
            4,
            6
          ]
        ],
        "expected": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "description": "Equal length merge",
        "is_hidden": false
      },
      {
        "input": [
          [],
          [
            1,
            2
          ]
        ],
        "expected": [
          1,
          2
        ],
        "description": "One empty list",
        "is_hidden": false
      },
      {
