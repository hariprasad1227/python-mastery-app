            3,
            5
          ],
          4
        ],
        "expected": -1,
        "description": "Missing element",
        "is_hidden": false
      },
      {
        "input": [
          [
            10,
            20,
            30
          ],
          10
        ],
        "expected": 0,
        "description": "First element",
        "is_hidden": true
      }
