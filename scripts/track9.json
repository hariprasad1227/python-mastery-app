[
  {
    "id": "chal-81",
    "order_index": 81,
    "level_number": 9,
    "slug": "challenge-group-by-initial",
    "title": "Group Words by Initial Letter",
    "difficulty": "easy",
    "instructions": "Write `group_by_initial(words: list[str]) -> dict[str, list[str]]` grouping words by their lowercase first letter.",
    "starter_code": "def group_by_initial(words: list[str]) -> dict[str, list[str]]:\n    pass\n",
    "solution_code": "def group_by_initial(words: list[str]) -> dict[str, list[str]]:\n    groups = {}\n    for w in words:\n        if not w:\n            continue\n        init = w[0].lower()\n        groups.setdefault(init, []).append(w)\n    return groups\n",
    "entry_function_name": "group_by_initial",
    "test_cases": [
      {
        "input": [
          [
            "apple",
            "banana",
            "apricot",
            "cherry",
            "blueberry"
          ]
        ],
        "expected": {
          "a": [
            "apple",
            "apricot"
          ],
          "b": [
            "banana",
            "blueberry"
          ],
          "c": [
            "cherry"
          ]
        },
        "description": "Initial grouping",
        "is_hidden": false
      },
      {
        "input": [
          []
        ],
        "expected": {},
        "description": "Empty list",
        "is_hidden": false
      },
      {
        "input": [
          [
            "Zebra",
            "zoo"
          ]
        ],
        "expected": {
          "z": [
            "Zebra",
            "zoo"
          ]
        },
        "description": "Case insensitive key",
        "is_hidden": true
      }
    ],
    "hints": [
      "Use dict.setdefault(init, []).append(w)."
    ],
    "xp_reward": 85,
    "time_limit_seconds": 462,
    "sandbox_timeout_seconds": 3.0
  },
  {
    "id": "chal-82",
    "order_index": 82,
    "level_number": 9,
    "slug": "challenge-top-k-frequent",
    "title": "Top K Frequent Elements",
    "difficulty": "medium",
    "instructions": "Write `top_k_frequent(items: list, k: int) -> list` returning the k most frequent elements sorted by frequency descending.",
    "starter_code": "def top_k_frequent(items: list, k: int) -> list:\n    pass\n",
    "solution_code": "def top_k_frequent(items: list, k: int) -> list:\n    from collections import Counter\n    counts = Counter(items)\n    sorted_items = sorted(counts.keys(), key=lambda x: (-counts[x], str(x)))\n    return sorted_items[:k]\n",
    "entry_function_name": "top_k_frequent",
    "test_cases": [
      {
        "input": [
          [
            1,
            1,
            1,
            2,
            2,
            3
          ],
          2
        ],
        "expected": [
          1,
          2
        ],
        "description": "Top 2 frequent",
        "is_hidden": false
      },
      {
        "input": [
          [
            "a",
            "b",
            "c"
          ],
          1
        ],
        "expected": [
          "a"
        ],
        "description": "Top 1 with tie",
        "is_hidden": false
      },
      {
        "input": [
          [
            4,
            4,
            4,
            4
          ],
          1
        ],
        "expected": [
          4
        ],
        "description": "Single dominant item",
        "is_hidden": true
      }
    ],
    "hints": [
      "Use collections.Counter.",
      "Sort by count descending."
    ],
    "xp_reward": 105,
    "time_limit_seconds": 464,
    "sandbox_timeout_seconds": 3.0
  },
  {
    "id": "chal-83",
    "order_index": 83,
    "level_number": 9,
    "slug": "challenge-moving-average",
    "title": "Moving Average Calculator",
    "difficulty": "medium",
    "instructions": "Write `moving_average(data: list[float], window: int) -> list[float]` computing moving averages of size window rounded to 2 decimals.",
    "starter_code": "def moving_average(data: list[float], window: int) -> list[float]:\n    pass\n",
    "solution_code": "def moving_average(data: list[float], window: int) -> list[float]:\n    if len(data) < window or window <= 0:\n        return []\n    res = []\n    for i in range(len(data) - window + 1):\n        avg = sum(data[i:i + window]) / window\n        res.append(round(avg, 2))\n    return res\n",
    "entry_function_name": "moving_average",
    "test_cases": [
      {
        "input": [
          [
            1,
            2,
            3,
            4,
            5
          ],
          3
        ],
        "expected": [
          2.0,
          3.0,
          4.0
        ],
        "description": "Window of 3",
        "is_hidden": false
      },
      {
        "input": [
          [
            10,
            20
          ],
          3
        ],
        "expected": [],
        "description": "Window > len returns []",
        "is_hidden": false
      },
      {
        "input": [
          [
            4.0,
            4.0,
            4.0
          ],
          2
        ],
        "expected": [
          4.0,
          4.0
        ],
        "description": "Identical floats",
        "is_hidden": true
      }
    ],
    "hints": [
      "Sum slice of size window and divide by window."
    ],
    "xp_reward": 100,
    "time_limit_seconds": 466,
    "sandbox_timeout_seconds": 3.0
  },
  {
    "id": "chal-84",
    "order_index": 84,
    "level_number": 9,
    "slug": "challenge-group-consecutive",
    "title": "Group Consecutive Elements",
    "difficulty": "medium",
    "instructions": "Write `group_consecutive(lst: list) -> list[list]` grouping consecutive equal items together.",
    "starter_code": "def group_consecutive(lst: list) -> list[list]:\n    pass\n",
    "solution_code": "def group_consecutive(lst: list) -> list[list]:\n    if not lst:\n        return []\n    res = []\n    cur = [lst[0]]\n    for x in lst[1:]:\n        if x == cur[0]:\n            cur.append(x)\n        else:\n            res.append(cur)\n            cur = [x]\n    res.append(cur)\n    return res\n",
    "entry_function_name": "group_consecutive",
    "test_cases": [
      {
        "input": [
          [
            1,
            1,
            2,
            3,
            3
          ]
        ],
        "expected": [
          [
            1,
            1
          ],
          [
            2
          ],
          [
            3,
            3
          ]
        ],
        "description": "1, 1, 2, 3, 3",
        "is_hidden": false
      },
      {
        "input": [
          [
            "a",
            "b",
            "c"
          ]
        ],
        "expected": [
          [
            "a"
          ],
          [
            "b"
          ],
          [
            "c"
          ]
        ],
        "description": "All distinct",
        "is_hidden": false
      },
      {
        "input": [
          []
        ],
        "expected": [],
        "description": "Empty list",
        "is_hidden": true
      }
    ],
    "hints": [
      "Group while x == cur[0]."
    ],
    "xp_reward": 95,
    "time_limit_seconds": 468,
    "sandbox_timeout_seconds": 3.0
  },
  {
    "id": "chal-85",
    "order_index": 85,
    "level_number": 9,
    "slug": "challenge-euclidean-distance",
    "title": "Euclidean Distance 2D",
    "difficulty": "easy",
    "instructions": "Write `euclidean_distance(p1: list[float], p2: list[float]) -> float` returning distance between [x1, y1] and [x2, y2] rounded to 2 decimals.",
    "starter_code": "def euclidean_distance(p1: list[float], p2: list[float]) -> float:\n    pass\n",
    "solution_code": "def euclidean_distance(p1: list[float], p2: list[float]) -> float:\n    dx = p1[0] - p2[0]\n    dy = p1[1] - p2[1]\n    return round((dx*dx + dy*dy)**0.5, 2)\n",
    "entry_function_name": "euclidean_distance",
    "test_cases": [
      {
        "input": [
          [
            0.0,
            0.0
          ],
          [
            3.0,
            4.0
          ]
        ],
        "expected": 5.0,
        "description": "3-4-5 triangle",
        "is_hidden": false
      },
      {
        "input": [
          [
            1.0,
            1.0
          ],
          [
            1.0,
            1.0
          ]
        ],
        "expected": 0.0,
        "description": "Same point",
        "is_hidden": false
      },
      {
        "input": [
          [
            -2.0,
            -3.0
          ],
          [
            1.0,
            1.0
          ]
        ],
        "expected": 5.0,
        "description": "Negatives",
        "is_hidden": true
      }
    ],
    "hints": [
      "Formula: sqrt((x2 - x1)^2 + (y2 - y1)^2)."
    ],
    "xp_reward": 80,
    "time_limit_seconds": 470,
    "sandbox_timeout_seconds": 3.0
  },
  {
    "id": "chal-86",
    "order_index": 86,
    "level_number": 9,
    "slug": "challenge-days-between",
    "title": "Days Between Two Dates",
    "difficulty": "easy",
    "instructions": "Write `days_between(d1: str, d2: str) -> int` returning absolute number of days between two 'YYYY-MM-DD' formatted dates.",
    "starter_code": "def days_between(d1: str, d2: str) -> int:\n    pass\n",
    "solution_code": "def days_between(d1: str, d2: str) -> int:\n    from datetime import datetime\n    dt1 = datetime.strptime(d1, '%Y-%m-%d')\n    dt2 = datetime.strptime(d2, '%Y-%m-%d')\n    return abs((dt2 - dt1).days)\n",
    "entry_function_name": "days_between",
    "test_cases": [
      {
        "input": [
          "2026-01-01",
          "2026-01-10"
        ],
        "expected": 9,
        "description": "9 days",
        "is_hidden": false
      },
      {
        "input": [
          "2025-12-31",
          "2026-01-01"
        ],
        "expected": 1,
        "description": "1 day new year",
        "is_hidden": false
      },
      {
        "input": [
          "2024-02-28",
          "2024-03-01"
        ],
        "expected": 2,
        "description": "Leap year day",
        "is_hidden": true
      }
    ],
    "hints": [
      "Use datetime.strptime.",
      "Subtract datetimes and get .days."
    ],
    "xp_reward": 85,
    "time_limit_seconds": 472,
    "sandbox_timeout_seconds": 3.0
  },
