  {
    "id": "chal-89",
    "order_index": 89,
    "level_number": 9,
    "slug": "challenge-parse-query-params",
    "title": "URL Query Parameter Parser",
    "difficulty": "medium",
    "instructions": "Write `parse_query_params(url: str) -> dict[str, str]` parsing query params after '?' into key-value pairs (or {} if none).",
    "starter_code": "def parse_query_params(url: str) -> dict[str, str]:\n    pass\n",
    "solution_code": "def parse_query_params(url: str) -> dict[str, str]:\n    if '?' not in url:\n        return {}\n    query = url.split('?', 1)[1]\n    res = {}\n    for pair in query.split('&'):\n        if '=' in pair:\n            k, v = pair.split('=', 1)\n            res[k] = v\n    return res\n",
    "entry_function_name": "parse_query_params",
    "test_cases": [
      {
        "input": [
          "https://example.com/search?q=python&lang=en"
        ],
        "expected": {
          "q": "python",
          "lang": "en"
        },
        "description": "Two params",
        "is_hidden": false
      },
      {
        "input": [
          "https://example.com/page"
        ],
        "expected": {},
        "description": "No params",
        "is_hidden": false
      },
      {
        "input": [
          "http://site.io/?a=1&b=2&c=3"
        ],
        "expected": {
          "a": "1",
          "b": "2",
          "c": "3"
        },
        "description": "Multiple params",
        "is_hidden": true
      }
    ],
    "hints": [
      "Split on '?' then split on '&'.",
      "Split each pair on '='."
    ],
    "xp_reward": 95,
    "time_limit_seconds": 478,
    "sandbox_timeout_seconds": 3.0
  },
