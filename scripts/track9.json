    "slug": "challenge-product-of-list",
    "title": "List Product using Fold",
    "difficulty": "easy",
    "instructions": "Write `product_of_list(nums: list[int]) -> int` returning product of all numbers (or 1 if empty).",
    "starter_code": "def product_of_list(nums: list[int]) -> int:\n    pass\n",
    "solution_code": "def product_of_list(nums: list[int]) -> int:\n    res = 1\n    for x in nums:\n        res *= x\n    return res\n",
    "entry_function_name": "product_of_list",
    "test_cases": [
      {
        "input": [
          [
