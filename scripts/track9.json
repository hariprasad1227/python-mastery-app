        "input": [
          []
        ],
        "expected": 1,
        "description": "Empty list returns 1",
        "is_hidden": false
      },
      {
        "input": [
          [
            -1,
            5,
            2
          ]
        ],
        "expected": -10,
        "description": "With negative",
        "is_hidden": true
      }
    ],
    "hints": [
